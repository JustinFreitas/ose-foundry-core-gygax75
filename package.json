{
  "private": true,
  "name": "ose",
  "version": "3.2.0-gygax75.2",
  "description": "",
  "type": "module",
  "scripts": {
    "clean": "node ./tools/clean.js dist .types-build",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:js": "rollup -c",
    "build:css": "sass src/ose.scss dist/ose.css --style=compressed --source-map",
    "build:types": "tsc -p tsconfig.types.json && rollup -c rollup.types.config.js",
    "release:types": "npm run build:types && npm publish ./packages/types",
    "watch": "npm-run-all --parallel watch:*",
    "watch:js": "rollup -c --watch",
    "watch:css": "sass --watch src/ose.scss dist/ose.css --source-map",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "link": "node ./tools/symlink.js",
    "unlink": "node ./tools/symlink.js -c",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "fix": "biome check --write src test"
  },
  "author": "Justin Freitas",
  "license": "",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@league-of-foundry-developers/foundry-vtt-types": "13.346.0-beta.20251209192131",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/livereload": "^0.9.5",
    "fs-extra": "^8.1.0",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.68.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "sass": "^1.108.1",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yargs": "^17.7.3"
  }
}
